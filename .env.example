# Used only by the runbook scripts (scripts/01 and later). Nothing here is a secret; the scripts read the AWS credentials
# from your own AWS CLI profiles or SSO sessions, never from this file. Copy to .env, fill in, and `set -a; source .env; set +a`.
SECURITY_PROFILE=
SECURITY_ACCOUNT_ID=
WORKLOAD_PROFILE=
WORKLOAD_ACCOUNT_ID=
ALERT_EMAIL=
AWS_REGION=eu-west-1
